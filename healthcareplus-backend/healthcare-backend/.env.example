# ── App ───────────────────────────────────────────────────────────────
APP_NAME=HealthCare+ API
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────
# Local dev (zero setup, file-based):
DATABASE_URL=sqlite:///./healthcareplus.db
# Production (Postgres) example — uncomment and fill in:
# DATABASE_URL=postgresql+psycopg2://healthcare_user:password@localhost:5432/healthcareplus

# ── Auth ──────────────────────────────────────────────────────────────
# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated is NOT supported directly by pydantic-settings list parsing
# from .env; set this as a JSON array string instead, e.g.:
# CORS_ORIGINS=["http://localhost:3000","https://app.yourdomain.com"]

# ── File uploads (Cloudinary-compatible) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Payments (Stripe architecture) ───────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── SMS booking confirmations (Twilio) ───────────────────────────────
# Leave these blank for now — the app works fine without them (it just
# logs what the SMS would have said instead of sending it). Once you buy
# a Twilio account, paste your 3 values here and confirmations will start
# actually sending automatically — no code changes needed.
#   Account SID  → from your Twilio Console dashboard
#   Auth Token   → from your Twilio Console dashboard
#   From Number  → the Twilio phone number you're assigned, e.g. +14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
